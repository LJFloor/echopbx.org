---
import { Icon } from "astro-icon/components";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/#features", label: "Features" },
  { href: "/install", label: "Install" },
  { href: "/faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-20 border-b border-slate-200 bg-white">
  <div class="wrap flex h-16 items-center gap-8">
    <a href="/" class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-slate-900">
      <img src="/favicon.svg" alt="" width="30" height="30" />
      EchoPBX
    </a>
    <nav class="hidden items-center gap-1 sm:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "rounded px-3 py-2 text-[0.9375rem] font-medium hover:bg-slate-100",
            path === l.href ? "text-slate-900" : "text-slate-600",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <a
      href="https://github.com/LJFloor/EchoPBX"
      class="ml-auto flex items-center gap-2 rounded border border-slate-300 px-3 py-1.5 text-sm font-semibold text-slate-900 hover:border-slate-900"
    >
      <Icon name="mdi:github" class="size-5" />
      <span>GitHub</span>
    </a>
  </div>
  <nav class="wrap flex gap-1 border-t border-slate-100 py-1 sm:hidden">
    {links.map((l) => (
      <a href={l.href} class="rounded px-3 py-2 text-sm font-medium text-slate-700">{l.label}</a>
    ))}
  </nav>
</header>
