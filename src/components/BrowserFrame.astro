---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  path: string;
  sizes: string;
  loading?: "eager" | "lazy";
}

const { src, alt, path, sizes, loading = "lazy" } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-slate-300 bg-white shadow-[0_24px_48px_-24px_rgb(15_23_42/0.35)]">
  <div class="flex h-9 items-center gap-3 border-b border-slate-200 bg-slate-100 px-3.5">
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-slate-300"></span>
      <span class="size-2.5 rounded-full bg-slate-300"></span>
      <span class="size-2.5 rounded-full bg-slate-300"></span>
    </div>
    <div class="mx-auto min-w-0 max-w-sm flex-1 truncate rounded bg-white px-3 py-0.5 text-center text-xs text-slate-500 ring-1 ring-slate-200">
      pbx.office.lan:8740{path}
    </div>
    <div class="w-[42px]" aria-hidden="true"></div>
  </div>
  <Image src={src} alt={alt} sizes={sizes} widths={[640, 1280, 2560]} loading={loading} class="block h-auto w-full" />
</div>
