---
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 bg-slate-50">
  <div class="wrap grid gap-8 py-12 sm:grid-cols-[2fr_1fr_1fr]">
    <div>
      <a href="/" class="flex items-center gap-2 font-bold text-slate-900">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        EchoPBX
      </a>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate-600">
        A self-hosted PBX that is simple to set up. Built on
        <a href="https://www.asterisk.org/" class="underline underline-offset-2 hover:text-slate-900">Asterisk</a>.
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-slate-900">Project</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a href="/install" class="hover:text-slate-900">Install</a></li>
        <li><a href="/faq" class="hover:text-slate-900">FAQ</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold text-slate-900">Source</h3>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a href="https://github.com/LJFloor/EchoPBX" class="hover:text-slate-900">GitHub</a></li>
        <li><a href="https://github.com/LJFloor/EchoPBX/issues" class="hover:text-slate-900">Issues</a></li>
        <li><a href="https://github.com/LJFloor/EchoPBX/blob/main/CONTRIBUTING.md" class="hover:text-slate-900">Contributing</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-200">
    <div class="wrap py-5 text-xs text-slate-500">
      © {year} EchoPBX. Released under the GNU GPL v2.
    </div>
  </div>
</footer>
